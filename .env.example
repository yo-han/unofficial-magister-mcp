# Required: your school's Magister subdomain (label, label.magister.net or https://label.magister.net)
MAGISTER_SCHOOL=schoolname

# Optional: keeps several accounts apart; only stored hashed (default: MAGISTER_USER, else "default")
# MAGISTER_PROFILE=default

# Optional, parent accounts: the child to use (default: the first linked child)
# MAGISTER_CHILD_ID=123456

# Optional: absolute directory for session state (default: the per-user state directory)
# MAGISTER_STATE_DIR=/Users/you/.magister-state

# Optional: set to false to never store a session (login is then refused)
# MAGISTER_PERSIST_SESSION=true

# Optional: maximum session age in days (1-365, default 30)
# MAGISTER_SESSION_MAX_AGE_DAYS=30

# Optional: exact https origins of your school's SSO provider, comma-separated
# MAGISTER_SSO_ORIGINS=https://login.example-school.nl

# Optional: interactive (default) or password
# MAGISTER_AUTH_MODE=interactive

# Password mode only; prefer interactive login so no password is stored here
# MAGISTER_USER=your-username
# MAGISTER_PASS=your-password

# Optional: 1 for debug events on stderr
# MAGISTER_DEBUG=0
