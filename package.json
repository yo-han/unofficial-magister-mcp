{
  "name": "unofficial-magister-mcp",
  "version": "1.1.0",
  "description": "MCP server for accessing Dutch Magister school schedules via Claude and other MCP clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "unofficial-magister-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "magister",
    "school",
    "schedule",
    "claude",
    "anthropic",
    "model-context-protocol",
    "netherlands",
    "dutch",
    "education"
  ],
  "author": "Israel Roldan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/israelroldan/unofficial-magister-mcp.git"
  },
  "homepage": "https://github.com/israelroldan/unofficial-magister-mcp#readme",
  "bugs": {
    "url": "https://github.com/israelroldan/unofficial-magister-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "htmlparser2": "^12.0.0",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
